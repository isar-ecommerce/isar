rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // সিকিউরিটি হেল্পার ফাংশনসমূহ (অপটিমাইজড ও ক্যাশড রিড)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (getUserData().role in ['admin', 'super_admin']);
    }

    function isSeller() {
      return isAuthenticated() && 
        (getUserData().role == 'seller' || isAdmin());
    }

    // ১. Users Collection Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) 
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ২. Products Collection Rules
    match /products/{productId} {
      allow read: if true;
      allow create: if isSeller() && 
        (request.resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || 
        (isSeller() && resource.data.sellerId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerId']));
      allow delete: if isAdmin();
    }

    // ৩. Reviews Collection Rules
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin() || 
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ৪. Categories Collection Rules
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ৫. Orders Collection Rules (কাস্টমার ইনভয়েস দেখা ও ১০ মিনিট এডিট উইন্ডো সহ)
    match /orders/{orderId} {
      allow create: if request.resource.data.totalAmount is number &&
                       request.resource.data.totalAmount >= 0;
                       
      allow read: if true;
      
      allow update: if isAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'transactionId', 'paymentMethod', 'updatedAt', 'paidAmount', 'dueAmount', 'shippingAddress', 'customerName', 'customerPhone']) &&
         request.resource.data.paymentStatus in ['paid', 'pending', 'partial', 'paid_delivery_fee']);
         
      allow delete: if isAdmin();
    }

    // ৬. Payments Collection Rules
    match /payments/{paymentId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerPhone == request.auth.token.phone_number);
      allow update, delete: if isAdmin();
    }

    // ৭. Legal Pages CMS Rules
    match /legalPages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ৮. Website Settings Rules
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ৯. Abandoned Carts Rules (ড্রাফট কার্ট সংরক্ষণ ও রিকভারি)
    match /abandoned_carts/{cartId} {
      allow create, update, delete: if true;
      allow read: if isAdmin();
    }

    // ১০. Restock Requests (স্টকে আসলে কাস্টমারকে জানানোর ফোন নম্বর)
    match /restock_requests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ১১. Product Questions (কাস্টমারদের প্রশ্ন ও অ্যাডমিন রিপ্লাই)
    match /product_questions/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}