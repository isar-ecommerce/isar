rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // সিকিউরিটি হেল্পার ফাংশনসমূহ
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    function isSeller() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' || isAdmin());
    }

    // ১. Users Collection Rules (ইউজার প্রোফাইল সিকিউরিটি)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ২. Products Collection Rules (পণ্য সিকিউরিটি)
    match /products/{productId} {
      allow read: if true; // যে কেউ প্রোডাক্ট দেখতে পারবে
      allow create: if isSeller(); // শুধু সেলার ও অ্যাডমিন যুক্ত করতে পারবে
      // সেলার/অ্যাডমিন পুরো প্রোডাক্ট আপডেট করতে পারবে অথবা কাস্টমার রিভিউ দেওয়ার পর rating ও reviewCount ফিল্ড আপডেট করতে পারবে
      allow update: if isSeller() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']));
      allow delete: if isAdmin();
    }

    // ৩. Reviews Collection Rules (কাস্টমার ফটো রিভিউ ও রেটিং সিকিউরিটি)
    match /reviews/{reviewId} {
      allow read: if true; // যে কেউ প্রোডাক্টের রিভিউ দেখতে পারবে
      // লগইন করা ইউজার নিজের আইডি দিয়ে নতুন রিভিউ তৈরি করতে পারবে
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // রিভিউ লেখক অথবা অ্যাডমিন এডিট করতে পারবে, অথবা কাস্টমাররা helpfulCount আপডেট করতে পারবে
      allow update: if isOwner(resource.data.userId) || isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ৪. Categories Collection Rules (ক্যাটাগরি সিকিউরিটি)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ৫. Orders Collection Rules (অর্ডার সিকিউরিটি)
    match /orders/{orderId} {
      allow create: if true; // যে কেউ অর্ডার প্লেস করতে পারবে
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ৬. Legal Pages CMS Rules (লিগ্যাল পেজ সিকিউরিটি)
    match /legalPages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ৭. Website Settings Rules (ওয়েবসাইট সেটিংস সিকিউরিটি)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}